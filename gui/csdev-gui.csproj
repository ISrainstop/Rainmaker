<Project Sdk="Microsoft.NET.Sdk">

  <!-- 客户端内置生成器: 把服务端 go/templates 的加密载荷模板作为资源嵌入。
       逻辑名用 csdev.templates.* 前缀, 与 NativeGenerator.cs 的读取约定一致。
       模板与服务端共用, 保证两端产出的原生格式载荷语义一致。 -->
  <ItemGroup>
    <EmbeddedResource Include="..\go\templates\key.bin" LogicalName="csdev.templates.key.bin" />
    <EmbeddedResource Include="..\go\templates\win2-exe.bin" LogicalName="csdev.templates.win2-exe.bin" />
    <EmbeddedResource Include="..\go\templates\win2-console.bin" LogicalName="csdev.templates.win2-console.bin" />
    <EmbeddedResource Include="..\go\templates\win2-svc.bin" LogicalName="csdev.templates.win2-svc.bin" />
    <EmbeddedResource Include="..\go\templates\win2-dll.bin" LogicalName="csdev.templates.win2-dll.bin" />
    <EmbeddedResource Include="..\go\templates\win2-raw.bin" LogicalName="csdev.templates.win2-raw.bin" />
    <EmbeddedResource Include="..\go\templates\win2-tcp.bin" LogicalName="csdev.templates.win2-tcp.bin" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <AssemblyName>csdev-gui</AssemblyName>
    <RootNamespace>CsdevGui</RootNamespace>
    <!-- 应用图标: 由 tools\gen_icon.ps1 生成 (7 个尺寸打包的 ICO)。
         换图标时重跑那个脚本即可, 不要手工换成单尺寸 ico —— 任务栏与开始菜单
         会按不同 DPI 取不同尺寸, 单尺寸会被拉伸糊掉。 -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- exe 的文件属性元数据: 任务栏悬停提示与"属性 → 详细信息"读的是这几个,
         不改的话会显示成程序集名 csdev-gui。 -->
    <AssemblyTitle>Rainmaker C2</AssemblyTitle>
    <Product>Rainmaker C2</Product>
    <Description>Rainmaker C2 控制台</Description>
    <Company>Rainmaker</Company>
    <Version>4.9.3</Version>
    <FileVersion>4.9.3.0</FileVersion>
    <LangVersion>latest</LangVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
