<Window x:Class="CsdevGui.TargetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新增目标" Width="540" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource Bg}"
        FontFamily="Microsoft YaHei UI">
    <StackPanel Margin="24,20,24,22">
        <TextBlock Text="新增目标" Style="{StaticResource Title}"/>
        <TextBlock Text="提交到 POST /api/targets {host, ip, os, note}（服务端按 host 去重，重复 host 会刷新来源与时间）"
                   Style="{StaticResource Hint}" Margin="0,8,0,14"/>

        <TextBlock Text="host（必填）" Style="{StaticResource Label}"/>
        <TextBox x:Name="HostBox" Style="{StaticResource Field}" FontFamily="Consolas"
                 Margin="0,0,0,12"/>

        <TextBlock Text="ip" Style="{StaticResource Label}"/>
        <TextBox x:Name="IpBox" Style="{StaticResource Field}" FontFamily="Consolas"
                 Margin="0,0,0,12"/>

        <TextBlock Text="os" Style="{StaticResource Label}"/>
        <TextBox x:Name="OsBox" Style="{StaticResource Field}" FontFamily="Consolas"
                 Margin="0,0,0,12"/>

        <TextBlock Text="note（备注，导出 CSV 会带上）" Style="{StaticResource Label}"/>
        <TextBox x:Name="NoteBox" Style="{StaticResource Field}" FontFamily="Consolas"/>

        <TextBlock x:Name="ErrorText" Text="" Foreground="{StaticResource Err}" FontSize="11.5"
                   Margin="0,12,0,0" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" Style="{StaticResource Ghost}" MinWidth="88" Click="Cancel_Click"/>
            <Button x:Name="BtnOk" Content="提交" Style="{StaticResource Primary}" MinWidth="88"
                    Margin="10,0,0,0" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
