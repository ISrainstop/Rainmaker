<Window x:Class="CsdevGui.ListenerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建监听器" Width="580" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource Bg}"
        FontFamily="Microsoft YaHei UI">
    <StackPanel Margin="24,20,24,22">
        <TextBlock Text="新建监听器" Style="{StaticResource Title}"/>
        <TextBlock Text="POST /api/listener/add {kind, addr}：类型与地址都在这里选定，确定后才下发"
                   Style="{StaticResource Hint}" Margin="0,8,0,14"/>

        <TextBlock Text="类型（kind）" Style="{StaticResource Label}"/>
        <ComboBox x:Name="KindBox" Style="{StaticResource Combo}"
                  SelectionChanged="Kind_SelectionChanged"/>

        <Border Background="{StaticResource Panel2}" CornerRadius="6" Padding="12,10"
                Margin="0,10,0,14">
            <TextBlock x:Name="KindNote" Text="" FontSize="11.5" TextWrapping="Wrap"
                       Foreground="{StaticResource Dim}"/>
        </Border>

        <TextBlock Text="监听地址（addr）" Style="{StaticResource Label}"/>
        <TextBox x:Name="AddrBox" Style="{StaticResource Field}" FontFamily="Consolas"/>
        <TextBlock x:Name="AddrNote" Text="" Style="{StaticResource Hint}"
                   Margin="0,5,0,0" TextWrapping="Wrap"/>

        <TextBlock x:Name="ErrorText" Text="" Foreground="{StaticResource Err}"
                   FontSize="11.5" Margin="0,12,0,0" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" Style="{StaticResource Ghost}" MinWidth="88" Click="Cancel_Click"/>
            <Button x:Name="BtnOk" Content="创建" Style="{StaticResource Primary}" MinWidth="88"
                    Margin="10,0,0,0" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
