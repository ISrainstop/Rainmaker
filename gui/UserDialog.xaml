<Window x:Class="CsdevGui.UserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加操作员账号" Width="470" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource Bg}"
        FontFamily="Microsoft YaHei UI">
    <StackPanel Margin="24,20,24,22">
        <TextBlock x:Name="HeadText" Text="添加操作员账号" Style="{StaticResource Title}"/>
        <TextBlock x:Name="SubText" Text="" Style="{StaticResource Hint}"
                   Margin="0,8,0,14" TextWrapping="Wrap"/>

        <TextBlock Text="用户名" Style="{StaticResource Label}"/>
        <TextBox x:Name="UserBox" Style="{StaticResource Field}" FontFamily="Consolas"
                 TextChanged="UserBox_TextChanged"/>
        <TextBlock x:Name="UserNote" Style="{StaticResource Hint}" Margin="0,5,0,12"
                   TextWrapping="Wrap"
                   Text="服务端按 sanitizeUser 清洗: 去首尾空白、去控制字符, 清洗后为空即非法"/>

        <StackPanel x:Name="RolePanel">
            <TextBlock Text="角色" Style="{StaticResource Label}"/>
            <ComboBox x:Name="RoleBox" Style="{StaticResource Combo}"/>
            <TextBlock Text="admin 才能管理账号; operator 只能看与下发命令"
                       Style="{StaticResource Hint}" Margin="0,5,0,12"/>
        </StackPanel>

        <TextBlock Text="口令" Style="{StaticResource Label}"/>
        <PasswordBox x:Name="PassBox" FontFamily="Consolas" Margin="0,0,0,12"/>

        <TextBlock Text="确认口令" Style="{StaticResource Label}"/>
        <PasswordBox x:Name="Pass2Box" FontFamily="Consolas"/>

        <TextBlock x:Name="ErrorText" Text="" Foreground="{StaticResource Err}"
                   FontSize="11.5" Margin="0,12,0,0" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" Style="{StaticResource Ghost}" MinWidth="88" Click="Cancel_Click"/>
            <Button x:Name="BtnOk" Content="添加" Style="{StaticResource Primary}" MinWidth="88"
                    Margin="10,0,0,0" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
