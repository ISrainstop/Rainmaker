<Window x:Class="CsdevGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Rainmaker C2 控制台" Height="880" Width="1420"
        MinHeight="640" MinWidth="1040"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        FontFamily="Microsoft YaHei UI">
    <!--
        自绘窗口边框: WindowStyle=None 去掉系统标题栏, 但**用 WindowChrome 而不是
        AllowsTransparency** 撑住系统行为 —— 后者会同时干掉窗口吸附(Aero Snap)、
        最大化动画和系统阴影。CaptionHeight=0 表示标题栏完全由我们自己画 (见下面顶栏),
        ResizeBorderThickness=6 把八向缩放的命中去交给系统, 不用手写命中测试。
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- ==================== 顶栏 (同时充当自绘标题栏) ==================== -->
        <Border Grid.Row="0" Background="{StaticResource HeaderGrad}"
                BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseDown">
            <Grid Margin="18,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Logo: 手写体 R + 左侧三道划痕, 与 app.ico 同源。
                         用 Segoe Script 而不是 Gabriola —— 后者的花体装饰只在小写上,
                         单个大写 R 会渲染成普通衬线 (实测确认)。 -->
                    <Border Width="30" Height="30" CornerRadius="9"
                            Background="{StaticResource Accent}" Margin="0,0,10,0">
                        <Grid>
                            <TextBlock Text="R" FontFamily="Segoe Script" FontSize="18" FontWeight="Bold"
                                       Foreground="#FFFFFF" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Margin="1,-2,0,0">
                                <TextBlock.RenderTransform>
                                    <SkewTransform AngleX="-8"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <!-- 三道划痕, 缩到 30px 时仍能看出是"痕"而不是噪点 -->
                            <Path Stroke="#B3FFFFFF" StrokeThickness="1.6" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M 4,7 L 8,10 M 3.2,13 L 7,16 M 4,19 L 7.5,21.5"
                                  VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Grid>
                    </Border>
                    <!-- 艺术体字标: 手写体 + 斜切 + 描边层 + 渐变 + 发光。
                         斜切用 SkewTransform 而不是只靠 FontStyle=Italic —— Segoe Script
                         本身已经是斜的, 再叠一层斜切才有"龙飞凤舞"的飞白感。 -->
                    <Grid VerticalAlignment="Center" Margin="2,0,0,0">
                        <TextBlock Text="Rainmaker" FontFamily="Segoe Script" FontSize="26"
                                   FontWeight="Bold" Foreground="#0C1E3E"
                                   Margin="1.4,1.4,-1.4,-1.4">
                            <TextBlock.RenderTransform>
                                <SkewTransform AngleX="-10"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock Text="Rainmaker" FontFamily="Segoe Script" FontSize="26"
                                   FontWeight="Bold">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#60A5FA" Offset="0"/>
                                    <GradientStop Color="#2563EB" Offset="0.45"/>
                                    <GradientStop Color="#0E7490" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#2563EB" BlurRadius="18" ShadowDepth="0" Opacity="0.55"/>
                            </TextBlock.Effect>
                            <TextBlock.RenderTransform>
                                <SkewTransform AngleX="-10"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Grid>
                    <TextBlock Text="C2" Foreground="{StaticResource Fg}"
                               FontFamily="Consolas" FontSize="17" FontWeight="Bold" Margin="8,0,0,2"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="console" Foreground="{StaticResource Dim}"
                               FontSize="11" VerticalAlignment="Bottom" Margin="8,0,0,6"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="24,0,0,0">
                    <TextBlock Text="服务端" Foreground="{StaticResource Dim}" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="ServerCombo" Style="{StaticResource Combo}" Width="215"
                              IsEditable="True" IsTextSearchEnabled="False"
                              KeyDown="ServerCombo_KeyDown"
                              SelectionChanged="ServerCombo_SelectionChanged"
                              ToolTip="保存过的服务端地址（下拉选择或直接输入）；『保存』把这一个地址与用户名写进 connections.json，口令不落盘">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" FontFamily="Consolas" FontSize="12"
                                           TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <!-- 按钮带矢量图标: 用 Segoe Fluent Icons / MDL2 Assets 的字形, 不引第三方图标包 -->
                    <Button x:Name="BtnConnect" Style="{StaticResource Ghost}"
                            Margin="8,0,0,0" Click="Connect_Click"
                            ToolTip="连接到服务端地址">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE71B;" Foreground="{StaticResource Ok}"/>
                            <TextBlock Text="连接" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnDisconnect" Style="{StaticResource Ghost}"
                            Margin="6,0,0,0" Click="Disconnect_Click"
                            ToolTip="断开轮询（数据保留在本地表格）">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" Foreground="{StaticResource Err}"/>
                            <TextBlock Text="断开" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnLogin" Style="{StaticResource Ghost}"
                            Margin="6,0,0,0" Click="Login_Click"
                            ToolTip="登录并获取 Bearer 令牌">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE77B;" Foreground="{StaticResource Accent}"/>
                            <TextBlock Text="登录" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnConnSave" Style="{StaticResource Ghost}"
                            Margin="10,0,0,0" Click="ConnSave_Click"
                            ToolTip="保存当前地址与已登录用户名（口令不落盘）">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" Foreground="{StaticResource Dim}"/>
                            <TextBlock Text="保存" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnConnDel" Style="{StaticResource Ghost}"
                            Margin="6,0,0,0" Click="ConnDelete_Click"
                            ToolTip="从列表与配置文件里删除当前选中的连接（二次确认）">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" Foreground="{StaticResource Err}"/>
                            <TextBlock Text="删除" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,10,0">
                    <!-- 连接状态: 药丸底色 + 状态点发光, 扫一眼就能判断链路通不通 -->
                    <Border Background="{StaticResource Panel2}" CornerRadius="13"
                            BorderBrush="{StaticResource LineSoft}" BorderThickness="1"
                            Padding="12,4" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7"
                                     Fill="{StaticResource Err}" VerticalAlignment="Center"
                                     Effect="{StaticResource GlowErr}"/>
                            <TextBlock x:Name="StatusText" Text="未连接"
                                       Foreground="{StaticResource Fg}" FontSize="11" Margin="7,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource Panel2}" CornerRadius="13"
                            BorderBrush="{StaticResource LineSoft}" BorderThickness="1"
                            Padding="12,4" Margin="0,0,10,0">
                        <TextBlock x:Name="SessionCount" Text="会话 0"
                                   Foreground="{StaticResource Fg}" FontSize="11"/>
                    </Border>
                    <TextBlock x:Name="ClockText" Foreground="{StaticResource Dim}"
                               FontFamily="Consolas" FontSize="11.5" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 自绘窗口按钮。码点取 MDL2 的标准 caption 字形:
                     E921 最小化 / E922 最大化 / E923 还原 / E8BB 关闭 -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="BtnWinMin" Style="{StaticResource WinBtn}" Content="&#xE921;"
                            Click="WinMin_Click" ToolTip="最小化"/>
                    <Button x:Name="BtnWinMax" Style="{StaticResource WinBtn}" Content="&#xE922;"
                            Click="WinMax_Click" ToolTip="最大化 / 还原"/>
                    <Button x:Name="BtnWinClose" Style="{StaticResource WinBtnClose}" Content="&#xE8BB;"
                            Click="WinClose_Click" ToolTip="关闭"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 主体 ==================== -->
        <TabControl x:Name="MainTabs" Grid.Row="1"
                    Background="{StaticResource Bg}" BorderThickness="0"
                    SelectionChanged="MainTabs_SelectionChanged">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource TabBarGrad}"
                                BorderBrush="{StaticResource LineSoft}"
                                BorderThickness="0,0,0,1">
                            <TabPanel IsItemsHost="True" Margin="8,0,0,0"/>
                        </Border>
                        <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>

            <!-- ========== 1. 会话 ========== -->
            <TabItem Header="会话" x:Name="TabSessions">
                <Grid Margin="12,12,12,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1.1*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,10">
                        <TextBlock Text="会话列表" Style="{StaticResource Title}"/>
                        <TextBlock x:Name="SessionHint" Text="选中一行后在下方交互终端下发命令；右键可结束会话 / 调整 sleep"
                                   Style="{StaticResource Sub}" Margin="12,3,0,0"/>
                    </StackPanel>

                    <DataGrid x:Name="GridSessions" Grid.Row="1"
                              SelectionChanged="GridSessions_SelectionChanged"
                              PreviewMouseRightButtonDown="GridSessions_PreviewMouseRightButtonDown"
                              MouseDoubleClick="GridSessions_MouseDoubleClick">
                        <DataGrid.ContextMenu>
                            <ContextMenu Opened="CtxSessions_Opened">
                                <MenuItem Header="设为当前会话" Click="CtxSetCurrent_Click"/>
                                <MenuItem Header="调整 sleep / jitter" Click="CtxSleep_Click"/>
                                <MenuItem Header="催心跳 checkin" Click="CtxCheckin_Click"/>
                                <Separator/>
                                <MenuItem Header="结束会话" Click="CtxExit_Click"/>
                                <Separator/>
                                <MenuItem Header="复制会话信息" Click="CtxCopy_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="sid" Binding="{Binding Sid}" Width="66"/>
                            <DataGridTemplateColumn Header="proto" Width="58">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                                     Fill="{Binding ProtoBrush}"/>
                                            <TextBlock Text="{Binding Proto}" Margin="6,0,0,0"
                                                       Foreground="{Binding ProtoBrush}" FontSize="11"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="host" Binding="{Binding Host}" Width="132"/>
                            <DataGridTextColumn Header="user" Binding="{Binding User}" Width="132"/>
                            <DataGridTextColumn Header="arch" Binding="{Binding Arch}" Width="52"/>
                            <DataGridTextColumn Header="pid" Binding="{Binding PidText}" Width="62"/>
                            <DataGridTextColumn Header="proc" Binding="{Binding Proc}" Width="132"/>
                            <DataGridTextColumn Header="os" Binding="{Binding Os}" Width="150"/>
                            <DataGridTextColumn Header="addr" Binding="{Binding Addr}" Width="150"/>
                            <DataGridTextColumn Header="idle" Binding="{Binding IdleText}" Width="66"/>
                            <DataGridTextColumn Header="sleep" Binding="{Binding SleepText}" Width="86"/>
                            <DataGridTextColumn Header="jitter" Binding="{Binding JitterText}" Width="58"/>
                            <DataGridTemplateColumn Header="队列" Width="62">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TaskText}" FontSize="11"
                                                   Foreground="{StaticResource Warn}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <GridSplitter Grid.Row="2" Height="6" Background="Transparent"/>

                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{StaticResource Panel2}"
                                CornerRadius="6,6,0,0" Padding="12,7">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="TermDot" Width="7" Height="7" Fill="{StaticResource Dim}"
                                         VerticalAlignment="Center"/>
                                <TextBlock x:Name="TermTitle" Text="终端  未选择会话"
                                           Foreground="{StaticResource Fg}" FontSize="11.5"
                                           Margin="8,0,0,0"/>
                                <TextBlock Text="Enter 执行  ·  ↑↓ 翻命令历史"
                                           Foreground="{StaticResource Dim}" FontSize="10.5"
                                           Margin="16,1,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Background="{StaticResource Panel2}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1,0,1,0">
                            <TextBox x:Name="Terminal" Style="{StaticResource Area}"
                                     IsReadOnly="True" AcceptsReturn="True"
                                     TextWrapping="Wrap" FontFamily="Consolas"
                                     VerticalScrollBarVisibility="Auto"
                                     IsTabStop="False"/>
                        </Border>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CmdInput" Grid.Column="0" Style="{StaticResource Field}"
                                     FontFamily="Consolas" KeyDown="CmdInput_KeyDown"/>
                            <Button x:Name="BtnSend" Grid.Column="1" Content="执行"
                                    Style="{StaticResource Primary}" Margin="8,0,0,0"
                                    Click="Send_Click"/>
                            <Button Grid.Column="2" Content="清屏" Style="{StaticResource Ghost}"
                                    Margin="8,0,0,0" Click="ClearTerm_Click"/>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ========== 2. 监听器 ========== -->
            <TabItem Header="监听器" x:Name="TabListeners">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,10">
                        <TextBlock Text="监听器" Style="{StaticResource Title}"/>
                        <Button Content="刷新" Style="{StaticResource Mini}" Margin="14,0,0,0"
                                Click="RefreshListeners_Click"/>
                        <TextBlock x:Name="LsnCount" Text="0 个" Style="{StaticResource Sub}"
                                   Margin="10,3,0,0"/>
                    </StackPanel>

                    <!-- 运行时新建: 全部在对话框里完成 (类型下拉 + 该类型的地址示例与说明 + 地址) -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="2,0,0,10">
                        <Button x:Name="BtnLsnAdd" Content="新建监听器" Style="{StaticResource Primary}"
                                Click="AddListener_Click"
                                ToolTip="弹出对话框选类型（HTTP / HTTPS / TCP / SMB / DNS / External C2）并填地址，确定后才下发 POST /api/listener/add"/>
                        <TextBlock x:Name="LsnKindHint" Style="{StaticResource Hint}" Margin="12,7,0,0"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   Text=""/>
                    </StackPanel>

                    <DataGrid x:Name="GridListeners" Grid.Row="2" MinHeight="140">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="name" Binding="{Binding Name}" Width="180"/>
                            <DataGridTextColumn Header="type" Binding="{Binding Type}" Width="80"/>
                            <DataGridTextColumn Header="proto" Binding="{Binding Proto}" Width="80"/>
                            <DataGridTextColumn Header="host" Binding="{Binding Host}" Width="150"/>
                            <DataGridTextColumn Header="port" Binding="{Binding Port}" Width="80"/>
                            <DataGridTextColumn Header="uri" Binding="{Binding Uri}" Width="120"/>
                            <DataGridTextColumn Header="addr (服务端)" Binding="{Binding AddrRawText}" Width="150"/>
                            <DataGridTextColumn Header="ssl" Binding="{Binding SslText}" Width="70"/>
                            <DataGridTextColumn Header="id" Binding="{Binding IdText}" Width="90"/>
                            <DataGridTextColumn Header="manageable" Binding="{Binding ManageText}" Width="96"/>
                            <DataGridTemplateColumn Header="up" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                     Fill="{Binding StatusBrush}"/>
                                            <TextBlock Text="{Binding UpText}" Margin="7,0,0,0"
                                                       Foreground="{Binding StatusBrush}" FontSize="11.5"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="操作" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="停止" Style="{StaticResource Mini}"
                                                IsEnabled="{Binding CanRemove}"
                                                ToolTip="{Binding RemoveHint}"
                                                ToolTipService.ShowOnDisabled="True"
                                                Click="ListenerRowStop_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="3" Style="{StaticResource Hint}" Margin="2,10,0,0" TextWrapping="Wrap"
                               Text="列表来源: GET /api/state.listeners（等价 GET /api/listeners），随 2 秒轮询差分刷新。创建走 POST /api/listener/add（tcp / smb / dns / extc2；HTTP(S) 运行期不可新增），停止走 POST /api/listener/remove，服务端 error（端口占用、主入口拒删等）一律原样显示。manageable=false 的行是进程启动时的控制台入口，『停止』按钮置灰。"/>
                </Grid>
            </TabItem>

            <!-- ========== 3. 凭据 ========== -->
            <TabItem Header="凭据">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,10">
                        <TextBlock Text="凭据库" Style="{StaticResource Title}"/>
                        <TextBlock x:Name="CredCount" Text="0 条" Style="{StaticResource Sub}"
                                   Margin="12,3,0,0"/>
                        <Button Content="复制密码" Style="{StaticResource Mini}" Margin="18,0,0,0"
                                Click="CopyPass_Click"/>
                        <Button Content="导出 CSV" Style="{StaticResource Mini}"
                                Click="ExportCsv_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="GridCreds" Grid.Row="1" MouseDoubleClick="GridCreds_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="user" Binding="{Binding User}" Width="200"/>
                            <DataGridTextColumn Header="secret" Binding="{Binding Secret}" Width="260"/>
                            <DataGridTextColumn Header="source" Binding="{Binding Source}" Width="180"/>
                            <DataGridTextColumn Header="sid" Binding="{Binding Sid}" Width="80"/>
                            <DataGridTextColumn Header="ts" Binding="{Binding TsText}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ========== 4. 下载 ========== -->
            <TabItem Header="下载">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,10">
                        <TextBlock Text="下载文件" Style="{StaticResource Title}"/>
                        <Button Content="打开文件" Style="{StaticResource Mini}" Margin="14,0,0,0"
                                Click="OpenDownload_Click"/>
                        <Button Content="打开所在目录" Style="{StaticResource Mini}"
                                Click="OpenDownloadDir_Click"/>
                        <Button Content="查看内容" Style="{StaticResource Mini}"
                                Click="ViewDownload_Click"
                                ToolTip="GET /api/download/file?id=&lt;记录号&gt; — 文本直接显示; 二进制如实说明并给大小与前 256 字节十六进制"/>
                        <Button Content="刷新" Style="{StaticResource Mini}"
                                Click="RefreshDownloads_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="GridDownloads" Grid.Row="1"
                              MouseDoubleClick="GridDownloads_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="name" Binding="{Binding Name}" Width="230"/>
                            <DataGridTextColumn Header="size" Binding="{Binding SizeText}" Width="100"/>
                            <DataGridTextColumn Header="sid" Binding="{Binding Sid}" Width="80"/>
                            <DataGridTextColumn Header="remote_path" Binding="{Binding RemotePath}" Width="320"/>
                            <DataGridTextColumn Header="ts" Binding="{Binding TsText}" Width="150"/>
                            <DataGridTextColumn Header="本地路径" Binding="{Binding Path}" Width="420"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ========== 5. 截屏 ========== -->
            <TabItem Header="截屏">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.1*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,10">
                            <TextBlock Text="截屏" Style="{StaticResource Title}"/>
                            <TextBlock x:Name="ShotCount" Text="0 张" Style="{StaticResource Sub}"
                                       Margin="12,3,0,0"/>
                            <Button Content="刷新" Style="{StaticResource Mini}" Margin="14,0,0,0"
                                    Click="RefreshShots_Click"/>
                        </StackPanel>

                        <ListBox x:Name="ListShots" Grid.Row="1"
                                 SelectionChanged="ListShots_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Panel3}" CornerRadius="6"
                                            Padding="7" Margin="7">
                                        <StackPanel Width="186">
                                            <Image Source="{Binding Thumb}" Width="176" Height="106"
                                                   Stretch="Uniform"/>
                                            <TextBlock Text="{Binding CapText}" FontSize="10"
                                                       Foreground="{StaticResource Dim}"
                                                       Margin="0,7,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <GridSplitter Grid.Column="1" Width="6" Background="Transparent"
                                  HorizontalAlignment="Center" Cursor="SizeWE"/>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="预览" Style="{StaticResource Title}"
                                   Margin="2,0,0,10"/>

                        <Border Grid.Row="1" Background="{StaticResource Panel2}" CornerRadius="8"
                                BorderBrush="{StaticResource Line}" BorderThickness="1">
                            <Image x:Name="ShotPreview" Stretch="Uniform" Margin="8"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="2,10,0,0">
                            <TextBlock x:Name="ShotInfo" Text="未选择" Style="{StaticResource Hint}"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button Content="用系统程序打开" Style="{StaticResource Mini}"
                                    Click="OpenShot_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ========== 6. 键盘记录 ========== -->
            <TabItem Header="键盘记录">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,10">
                        <TextBlock Text="键盘记录" Style="{StaticResource Title}"/>
                        <TextBlock x:Name="KeylogCount" Text="0 条" Style="{StaticResource Sub}"
                                   Margin="12,3,0,0"/>
                        <TextBlock Text="来源: GET /api/state.keylogs（服务端整条入库, 双击行复制内容）"
                                   Style="{StaticResource Sub}" Margin="14,3,0,0"/>
                    </StackPanel>

                    <DataGrid x:Name="GridKeylogs" Grid.Row="1" MouseDoubleClick="GridKeylogs_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="sid" Binding="{Binding Sid}" Width="80"/>
                            <DataGridTextColumn Header="source" Binding="{Binding Source}" Width="180"/>
                            <DataGridTextColumn Header="ts" Binding="{Binding TsText}" Width="150"/>
                            <DataGridTemplateColumn Header="text" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}" FontFamily="Consolas"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Text}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ========== 7. 事件日志 ========== -->
            <TabItem Header="事件日志">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,10">
                        <TextBlock Text="事件时间线" Style="{StaticResource Title}"/>
                        <TextBlock Text="来源: GET /api/state.events（服务端保留最近 300 条, 新事件在前）"
                                   Style="{StaticResource Sub}" Margin="12,3,0,0"/>
                        <Button Content="刷新" Style="{StaticResource Mini}" Margin="14,0,0,0"
                                Click="RefreshEvents_Click"/>
                    </StackPanel>

                    <ListBox x:Name="ListEvents" Grid.Row="1"
                             VirtualizingPanel.IsVirtualizing="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,7" BorderThickness="3,0,0,0"
                                        BorderBrush="{Binding CatBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding TsText}"
                                                   FontFamily="Consolas" FontSize="11"
                                                   Foreground="{StaticResource Dim}" Width="104"
                                                   VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Background="{StaticResource Panel3}"
                                                CornerRadius="3" Padding="6,1" Margin="0,0,10,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Cat}" FontSize="10"
                                                       Foreground="{Binding CatBrush}"/>
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding Action}"
                                                   Foreground="{StaticResource Fg}" FontSize="12"
                                                   Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Detail}"
                                                   Foreground="{StaticResource Dim}" FontSize="11.5"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Detail}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- ========== 8. 载荷生成 ========== -->
            <TabItem Header="载荷生成" x:Name="TabPayload">
                <Border Background="{StaticResource Panel2}" Padding="26,22">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid MaxWidth="900" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="440"/>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="生成载荷" Style="{StaticResource Title}"/>
                                <TextBlock Text="构建由服务端同步执行: POST /api/payload/build -&gt; tools/gen_payload.ps1"
                                           Style="{StaticResource Sub}" Margin="0,5,0,20"/>

                                <TextBlock Text="载荷格式（GET /api/payload/formats）" Style="{StaticResource Label}"/>
                                <ComboBox x:Name="FmtBox" Style="{StaticResource Combo}"
                                          Margin="0,0,0,14">
                                    <!--
                                        用 ItemTemplate 而不是 DisplayMemberPath: ComboBox 的自定义模板
                                        (App.xaml 里为了改下拉弹出层背景而重写的那份) 不会转发
                                        DisplayMemberPath, 只认 SelectionBoxItemTemplate。
                                        写成 DisplayMemberPath 的话选中项会显示成类型名。
                                    -->
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Display}" FontFamily="Consolas" FontSize="12"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="C2 地址" Style="{StaticResource Label}"/>
                                        <TextBox x:Name="HostBox" Style="{StaticResource Field}"
                                                 FontFamily="Consolas"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="端口" Style="{StaticResource Label}"/>
                                        <TextBox x:Name="PortBox" Style="{StaticResource Field}"
                                                 Text="8443" FontFamily="Consolas"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="sleep (ms)" Style="{StaticResource Label}"/>
                                        <TextBox x:Name="SleepBox" Style="{StaticResource Field}"
                                                 Text="5000" FontFamily="Consolas"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="jitter (%)" Style="{StaticResource Label}"/>
                                        <TextBox x:Name="JitterBox" Style="{StaticResource Field}"
                                                 Text="10" FontFamily="Consolas"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="输出路径（服务端路径; 留空由生成器决定）" Style="{StaticResource Label}"/>
                                <TextBox x:Name="OutBox" Style="{StaticResource Field}"
                                         FontFamily="Consolas" Margin="0,0,0,14"/>

                                <CheckBox x:Name="SslBox" Content="使用 HTTPS (-Ssl)"
                                          Style="{StaticResource Chk}" Margin="0,4,0,14"/>

                                <!-- 启动口令门控 (password): 留空 = 不加门控。口令不回显、不落盘 -->
                                <TextBlock Text="启动口令（可空 · 启动口令门控）" Style="{StaticResource Label}"/>
                                <PasswordBox x:Name="PwdBox" Height="30" Padding="8,4" FontFamily="Consolas"
                                             Background="{StaticResource Bg}" Foreground="{StaticResource Fg}"
                                             BorderBrush="{StaticResource Line}" BorderThickness="1"
                                             CaretBrush="{StaticResource Fg}"
                                             PasswordChanged="PwdBox_PasswordChanged"/>
                                <TextBlock x:Name="PwdHint" Style="{StaticResource Hint}" Margin="0,4,0,16"
                                           TextWrapping="Wrap"
                                           Text="用途: 植入体启动时校验口令, 不匹配就安静退出 —— 自动化沙箱直接运行样本拿不到任何行为。运行时用法: &lt;样本&gt; &lt;口令&gt; 或设环境变量 CSDEV_TOKEN。留空 = 不加门控, 直接运行。口令不回显在状态栏/日志, 也不写入任何配置或最近使用记录。"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnBuild" Content="开始生成"
                                            Style="{StaticResource Primary}" Click="Generate_Click"/>
                                    <Button Content="重新拉取格式" Style="{StaticResource Ghost}"
                                            Margin="10,0,0,0" Click="LoadFormats_Click"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="生成日志" Style="{StaticResource Label}"/>
                                <Border Background="{StaticResource Bg}" CornerRadius="8"
                                        BorderBrush="{StaticResource Line}" BorderThickness="1"
                                        MinHeight="380" Padding="14,12">
                                    <TextBox x:Name="GenLog" Style="{StaticResource Area}"
                                             IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                             FontFamily="Consolas" VerticalScrollBarVisibility="Auto"
                                             IsTabStop="False"/>
                                </Border>
                                <TextBlock x:Name="GenHint" Style="{StaticResource Hint}" Margin="0,10,0,0"
                                           TextWrapping="Wrap"
                                           Text="提示: 服务端生成脚本 tools/gen_payload.ps1 未声明 -Sleep / -Jitter 参数, 若服务端返回参数错误, 客户端会自动省略这两个参数重试一次, 并在日志中标注。启用启动口令后, 服务端回传的日志(含 [口令门控] 已启用那两行)原样显示在左侧, 其中的口令明文已被隐去。"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- ========== 9. 文件浏览器 ========== -->
            <TabItem Header="文件" x:Name="TabFileBrowser">
                <Grid Margin="12,12,12,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,8">
                        <TextBlock Text="文件浏览器" Style="{StaticResource Title}"/>
                        <TextBlock x:Name="FsSession" Text="未选择会话" Style="{StaticResource Sub}"
                                   Margin="12,3,0,0"/>
                        <TextBlock x:Name="FsCount" Text="0 项" Style="{StaticResource Sub}"
                                   Margin="10,3,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="{StaticResource Panel2}" CornerRadius="6"
                            Padding="10,8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="路径" Foreground="{StaticResource Dim}"
                                       FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="FsPath" Grid.Column="1" Style="{StaticResource Field}"
                                     FontFamily="Consolas"
                                     ToolTip="可直接改写远端路径后回车重新枚举；支持 C:\ 与 / 混用、.. 相对"
                                     KeyDown="FsPath_KeyDown"/>
                            <Button Grid.Column="2" Content="上级" Style="{StaticResource Mini}"
                                    Margin="8,0,0,0" Click="FsUp_Click"
                                    ToolTip="枚举父目录"/>
                            <Button Grid.Column="3" Content="刷新" Style="{StaticResource Mini}"
                                    Margin="6,0,0,0" Click="FsRefresh_Click"
                                    ToolTip="重新枚举当前路径"/>
                            <Button Grid.Column="4" Content="下载" Style="{StaticResource Mini}"
                                    Margin="6,0,0,0" Click="FsDownload_Click"
                                    ToolTip="对选中项下发 download（下载列表在下一次轮询出现）"/>
                            <Button Grid.Column="5" Content="上传" Style="{StaticResource Mini}"
                                    Margin="6,0,0,0" Click="FsUpload_Click"
                                    ToolTip="选择本地文件 -> 下发 upload &lt;本地路径&gt; &lt;远端路径&gt;"/>
                        </Grid>
                    </Border>

                    <DataGrid x:Name="GridFs" Grid.Row="2"
                              MouseDoubleClick="GridFs_MouseDoubleClick"
                              PreviewMouseRightButtonDown="GridFs_PreviewMouseRightButtonDown">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="进入目录 / 下载" Click="FsCtxOpen_Click"/>
                                <MenuItem Header="读取内容 (cat)" Click="FsCtxCat_Click"/>
                                <MenuItem Header="下载 (download)" Click="FsCtxDownload_Click"/>
                                <Separator/>
                                <MenuItem Header="新建目录 (mkdir)" Click="FsCtxMkdir_Click"/>
                                <MenuItem Header="删除 (rm)" Click="FsCtxRm_Click"/>
                                <Separator/>
                                <MenuItem Header="复制完整路径" Click="FsCtxCopyPath_Click"/>
                                <MenuItem Header="复制文件名" Click="FsCtxCopyName_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="类型" Binding="{Binding TypeMark}" Width="52"/>
                            <DataGridTextColumn Header="说明" Binding="{Binding Kind}" Width="70"/>
                            <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="100"/>
                            <DataGridTextColumn Header="操作" Binding="{Binding OpText}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="3" x:Name="FsHint" Style="{StaticResource Hint}" Margin="2,8,0,0"
                               Text="双击目录进入、双击文件下载；数据来自 ls 回传（字段：类型 TAB 字节数 TAB 名称）。下发与回传同时显示在会话终端。"/>
                </Grid>
            </TabItem>

            <!-- ========== 10. 进程浏览器 ========== -->
            <TabItem Header="进程" x:Name="TabProcBrowser">
                <Grid Margin="12,12,12,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,8">
                        <TextBlock Text="进程浏览器" Style="{StaticResource Title}"/>
                        <TextBlock x:Name="ProcSession" Text="未选择会话" Style="{StaticResource Sub}"
                                   Margin="12,3,0,0"/>
                        <TextBlock x:Name="ProcCount" Text="0 项" Style="{StaticResource Sub}"
                                   Margin="10,3,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="{StaticResource Panel2}" CornerRadius="6"
                            Padding="10,8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="过滤" Foreground="{StaticResource Dim}"
                                       FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="ProcFilter" Grid.Column="1" Style="{StaticResource Field}"
                                     FontFamily="Consolas"
                                     ToolTip="按进程名或 PID 模糊过滤（纯本地过滤，不再下发命令）"
                                     TextChanged="ProcFilter_TextChanged"/>
                            <Button Grid.Column="2" Content="清除" Style="{StaticResource Mini}"
                                    Margin="8,0,0,0" Click="ProcFilterClear_Click"/>
                            <Button Grid.Column="3" Content="刷新" Style="{StaticResource Mini}"
                                    Margin="6,0,0,0" Click="ProcRefresh_Click"
                                    ToolTip="下发 ps 并等待回传"/>
                            <Button Grid.Column="4" Content="重置排序" Style="{StaticResource Mini}"
                                    Margin="6,0,0,0" Click="ProcSortReset_Click"
                                    ToolTip="清除列排序，恢复植入体回传顺序"/>
                        </Grid>
                    </Border>

                    <DataGrid x:Name="GridProc" Grid.Row="2"
                              PreviewMouseRightButtonDown="GridProc_PreviewMouseRightButtonDown">
                        <DataGrid.ContextMenu>
                            <ContextMenu Opened="CtxProc_Opened">
                                <MenuItem Header="刷新 (ps)" Click="ProcRefresh_Click"/>
                                <Separator/>
                                <MenuItem Header="结束进程" Click="ProcCtxKill_Click"/>
                                <MenuItem Header="注入 shellcode (inject)" Click="ProcCtxInject_Click"/>
                                <Separator/>
                                <MenuItem Header="复制 PID" Click="ProcCtxCopyPid_Click"/>
                                <MenuItem Header="复制进程信息" Click="ProcCtxCopyInfo_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Height" Value="27"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Panel3}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SelRow}"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding Self}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Warn}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Raw}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Dim}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PID" Binding="{Binding PidText}" Width="90"
                                                SortMemberPath="Pid"/>
                            <DataGridTextColumn Header="PPID" Binding="{Binding PpidText}" Width="90"
                                                SortMemberPath="Ppid"/>
                            <DataGridTextColumn Header="线程" Binding="{Binding ThreadsText}" Width="70"
                                                SortMemberPath="Threads"/>
                            <DataGridTextColumn Header="进程名" Binding="{Binding Name}" Width="*"
                                                SortMemberPath="Name"/>
                            <DataGridTextColumn Header="备注" Binding="{Binding RowMark}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="3" x:Name="ProcHint" Style="{StaticResource Hint}" Margin="2,8,0,0"
                               Text="数据来自 ps 回传（字段：PID TAB PPID TAB 线程数 TAB 进程名）。橙色行 = 当前会话自身进程。"/>
                </Grid>
            </TabItem>

            <!-- ========== 11. 服务端 ========== -->
            <TabItem Header="服务端" x:Name="TabServer">
                <Border Background="{StaticResource Panel2}" Padding="26,22">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                            <TextBlock Text="服务端状态" Style="{StaticResource Title}"/>
                            <TextBlock x:Name="SrvAddrText" Text="-" Style="{StaticResource Sub}"/>

                            <Border Background="{StaticResource Bg}" CornerRadius="8"
                                    BorderBrush="{StaticResource Line}" BorderThickness="1"
                                    Margin="0,18,0,0" Padding="18,16">
                                <StackPanel>
                                    <TextBlock Text="GET /api/state" Foreground="{StaticResource Dim}"
                                               FontSize="11" FontFamily="Consolas" Margin="0,0,0,12"/>
                                    <TextBlock x:Name="SrvHostText" Text="host      -"
                                               Foreground="{StaticResource Fg}" FontFamily="Consolas"
                                               FontSize="12.5" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="SrvProtoText" Text="proto_v2  -"
                                               Foreground="{StaticResource Fg}" FontFamily="Consolas"
                                               FontSize="12.5" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="SrvProfileText" Text="profile   -"
                                               Foreground="{StaticResource Fg}" FontFamily="Consolas"
                                               FontSize="12.5" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="SrvStatsText" Text="stats     -"
                                               Foreground="{StaticResource Fg}" FontFamily="Consolas"
                                               FontSize="12.5" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <Button Content="立即刷新" Style="{StaticResource Ghost}"
                                        Click="RefreshState_Click"/>
                                <Button Content="终止全部 v2 会话" Style="{StaticResource Ghost}"
                                        Margin="10,0,0,0" Click="KillAll_Click"/>
                            </StackPanel>

                            <!-- 操作员账号管理: GET /api/users + /api/user/{new,delete,pass}
                                 进页面懒加载一次 + 显式刷新, 不进 2 秒轮询 (它是显式操作的对象) -->
                            <Border Background="{StaticResource Bg}" CornerRadius="8"
                                    Margin="0,22,0,0" Padding="18,16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="操作员账号" Foreground="{StaticResource Dim}"
                                                   FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="AcctCount" Text="0 个" Style="{StaticResource Sub}"
                                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        <Button Content="刷新" Style="{StaticResource Mini}"
                                                Margin="12,0,0,0" Click="AcctRefresh_Click"/>
                                        <Button x:Name="BtnAcctAdd" Content="添加账号"
                                                Style="{StaticResource Mini}" Margin="6,0,0,0"
                                                Click="AcctAdd_Click"
                                                ToolTip="弹出对话框：用户名 + 角色下拉（admin / operator）+ 口令 + 确认口令"/>
                                    </StackPanel>
                                    <TextBlock x:Name="AcctHint" Style="{StaticResource Hint}"
                                               Margin="0,8,0,0" TextWrapping="Wrap" Text=""/>
                                    <DataGrid x:Name="GridUsers" MinHeight="150" Margin="0,10,0,0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="用户名" Binding="{Binding User}" Width="190"/>
                                            <DataGridTextColumn Header="角色" Binding="{Binding RoleText}" Width="100"/>
                                            <DataGridTextColumn Header="最后登录" Binding="{Binding LastText}" Width="162"/>
                                            <DataGridTextColumn Header="当前" Binding="{Binding SelfText}" Width="80"/>
                                            <DataGridTemplateColumn Header="操作" Width="168">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="改口令" Style="{StaticResource Mini}"
                                                                    Click="UserRowPass_Click"/>
                                                            <Button Content="删除" Style="{StaticResource Mini}"
                                                                    Margin="6,0,0,0"
                                                                    IsEnabled="{Binding CanDelete}"
                                                                    ToolTip="{Binding DeleteHint}"
                                                                    ToolTipService.ShowOnDisabled="True"
                                                                    Click="UserRowDelete_Click"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock x:Name="AcctNote" Style="{StaticResource Hint}"
                                               Margin="0,8,0,0" TextWrapping="Wrap" Text=""/>
                                </StackPanel>
                            </Border>

                            <!-- 报告导出: GET /api/report/{json,html,csv?kind=..}
                                 三个端点都回文件流 (CSV 带 UTF-8 BOM), 保存按字节原样落盘,
                                 不当 JSON 解析、不做编码转换; 需 Bearer 令牌 (401 提示需要登录) -->
                            <Border Background="{StaticResource Bg}" CornerRadius="8"
                                    Margin="0,22,0,0" Padding="18,16">
                                <StackPanel>
                                    <TextBlock Text="报告导出" Foreground="{StaticResource Dim}"
                                               FontSize="11" Margin="0,0,0,8"/>
                                    <TextBlock Text="GET /api/report/json | /api/report/html | /api/report/csv?kind=…  (需登录)"
                                               Foreground="{StaticResource Dim}" FontSize="11"
                                               FontFamily="Consolas" Margin="0,0,0,12"/>

                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="导出 JSON" Style="{StaticResource Mini}"
                                                Click="ExportReportJson_Click"
                                                ToolTip="GET /api/report/json — 全量活动快照 (原样字节落盘)"/>
                                        <Button Content="导出 HTML" Style="{StaticResource Mini}"
                                                Click="ExportReportHtml_Click"
                                                ToolTip="GET /api/report/html — 自包含单文件 HTML (内嵌 CSS, 无外部依赖)"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="CSV 类型" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Fg}" FontSize="12"/>
                                        <ComboBox x:Name="ReportKindBox" Width="210" Height="26"
                                                  Margin="10,0,0,0" VerticalContentAlignment="Center"
                                                  ToolTip="对应 /api/report/csv?kind=… 的 kind 取值">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Label}" FontFamily="Consolas" FontSize="12"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Content="导出 CSV" Style="{StaticResource Mini}"
                                                Margin="10,0,0,0" Click="ExportReportCsv_Click"
                                                ToolTip="服务端返回带 UTF-8 BOM 的 CSV, 保存时原样写字节 (不做编码转换)"/>
                                    </StackPanel>

                                    <TextBlock x:Name="ReportHint" Style="{StaticResource Hint}"
                                               Margin="0,8,0,0" TextWrapping="Wrap" Text=""/>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource Bg}" CornerRadius="8"
                                    Margin="0,22,0,0" Padding="18,16">
                                <StackPanel>
                                    <TextBlock Text="启动命令" Foreground="{StaticResource Dim}"
                                               FontSize="11" Margin="0,0,0,8"/>
                                    <TextBlock FontFamily="Consolas" FontSize="12"
                                               Foreground="{StaticResource Accent}"
                                               TextWrapping="Wrap"
                                               Text="csdev-server.exe --port 8443 --host 0.0.0.0"/>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                               Text="轮询: 单个 DispatcherTimer(2s) 只调用一次 GET /api/state 拉全量; 选中会话时在同一 tick 内追加一次 GET /api/output 增量。"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- ========== 12. 目标库 ========== -->
            <TabItem Header="目标库" x:Name="TabTargets">
                <Grid Margin="12,12,12,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,8">
                        <TextBlock Text="目标主机库" Style="{StaticResource Title}"/>
                        <TextBlock x:Name="TargetCount" Text="0 条" Style="{StaticResource Sub}"
                                   Margin="12,3,0,0"/>
                        <TextBlock Text="来源: GET /api/state.targets（服务端按 host 去重登记）"
                                   Style="{StaticResource Sub}" Margin="10,3,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="{StaticResource Panel2}" CornerRadius="6"
                            Padding="10,8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="搜索" Foreground="{StaticResource Dim}"
                                       FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="TargetFilter" Grid.Column="1" Style="{StaticResource Field}"
                                     FontFamily="Consolas"
                                     ToolTip="按 host / ip / note 模糊过滤（纯客户端过滤，不额外请求服务端）"
                                     TextChanged="TargetFilter_TextChanged"/>
                            <Button Grid.Column="2" Content="清除" Style="{StaticResource Mini}"
                                    Margin="8,0,0,0" Click="TargetFilterClear_Click"/>
                            <Button Grid.Column="3" Content="新增目标" Style="{StaticResource Mini}"
                                    Margin="12,0,0,0" Click="TargetAdd_Click"/>
                            <Button Grid.Column="4" Content="导出 CSV" Style="{StaticResource Mini}"
                                    Margin="6,0,0,0" Click="TargetExport_Click"/>
                            <Button Grid.Column="5" Content="刷新" Style="{StaticResource Mini}"
                                    Margin="6,0,0,0" Click="TargetRefresh_Click"/>
                        </Grid>
                    </Border>

                    <DataGrid x:Name="GridTargets" Grid.Row="2"
                              PreviewMouseRightButtonDown="GridTargets_PreviewMouseRightButtonDown"
                              MouseDoubleClick="GridTargets_MouseDoubleClick">
                        <DataGrid.ContextMenu>
                            <ContextMenu Opened="CtxTargets_Opened">
                                <MenuItem Header="对该目标发起命令" Click="TargetCtxCmd_Click"/>
                                <Separator/>
                                <MenuItem Header="复制主机名" Click="TargetCtxCopyHost_Click"/>
                                <MenuItem Header="复制目标信息" Click="TargetCtxCopyInfo_Click"/>
                                <Separator/>
                                <MenuItem Header="新增目标" Click="TargetAdd_Click"/>
                                <MenuItem Header="删除目标" Click="TargetDelete_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="host" Binding="{Binding Host}" Width="190"/>
                            <DataGridTextColumn Header="ip" Binding="{Binding IpText}" Width="130"/>
                            <DataGridTextColumn Header="os" Binding="{Binding OsText}" Width="170"/>
                            <DataGridTemplateColumn Header="source" Width="260">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding SourceTags}"
                                                      VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource Panel3}"
                                                            CornerRadius="3" Padding="6,1"
                                                            Margin="0,0,5,0">
                                                        <TextBlock Text="{Binding Name}"
                                                                   Foreground="{Binding Brush}"
                                                                   FontSize="10"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="sid" Binding="{Binding SidText}" Width="80"/>
                            <DataGridTextColumn Header="note" Binding="{Binding NoteText}" Width="*"/>
                            <DataGridTextColumn Header="ts" Binding="{Binding TsText}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="3" x:Name="TargetHint" Style="{StaticResource Hint}"
                               Margin="2,8,0,0"
                               Text="source 彩色标签: beacon 蓝 / scan 灰 / lateral 橙 / manual 绿 / 其它 紫。双击或右键可对该目标发起命令（需要该目标带 sid 且会话在线），右键菜单可删除目标。"/>
                </Grid>
            </TabItem>

            <!-- ========== 13. 代理枢轴 ========== -->
            <TabItem Header="代理枢轴" x:Name="TabProxy">
                <Grid Margin="12,12,12,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1.15*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,8">
                        <TextBlock Text="代理枢轴" Style="{StaticResource Title}"/>
                        <TextBlock Text="来源: GET /api/state.proxy（SOCKS 入口 + 反向端口转发 + 全量计数器）"
                                   Style="{StaticResource Sub}" Margin="12,3,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="{StaticResource Panel2}" CornerRadius="6"
                            Padding="12,8" Margin="0,0,0,8">
                        <TextBlock x:Name="ProxyStats" Text="总通道数 0" Foreground="{StaticResource Fg}"
                                   FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap"/>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="2,0,0,8">
                        <TextBlock Text="SOCKS 入口" Style="{StaticResource Label}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="SocksCount" Text="0 个" Style="{StaticResource Sub}"
                                   Margin="10,3,0,0"/>
                        <Button Content="启动 SOCKS" Style="{StaticResource Mini}" Margin="16,0,0,0"
                                Click="ProxyStart_Click"/>
                        <Button Content="停止 SOCKS" Style="{StaticResource Mini}" Margin="6,0,0,0"
                                Click="ProxyStop_Click"/>
                        <Button Content="刷新" Style="{StaticResource Mini}" Margin="6,0,0,0"
                                Click="ProxyRefresh_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="GridSocks" Grid.Row="3"
                              PreviewMouseRightButtonDown="GridSocks_PreviewMouseRightButtonDown">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="复制用法提示" Click="SocksCtxCopyUsage_Click"/>
                                <MenuItem Header="停止该条目" Click="SocksCtxStop_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="sid" Binding="{Binding Sid}" Width="86"/>
                            <DataGridTextColumn Header="监听地址" Binding="{Binding ListenText}" Width="*"/>
                            <DataGridTextColumn Header="通道数" Binding="{Binding ChansText}" Width="90"/>
                            <DataGridTextColumn Header="下行 TLV 数" Binding="{Binding TxTlvText}" Width="118"/>
                            <DataGridTextColumn Header="上行字节" Binding="{Binding UpBText}" Width="118"/>
                            <DataGridTextColumn Header="客户端读入" Binding="{Binding RxBText}" Width="118"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="2,10,0,8">
                        <TextBlock Text="反向端口转发 (rportfwd)" Style="{StaticResource Label}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="RportCount" Text="0 个" Style="{StaticResource Sub}"
                                   Margin="10,3,0,0"/>
                        <Button Content="启动 rportfwd" Style="{StaticResource Mini}" Margin="16,0,0,0"
                                Click="RportStart_Click"/>
                        <Button Content="停止 rportfwd" Style="{StaticResource Mini}" Margin="6,0,0,0"
                                Click="RportStop_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="GridRports" Grid.Row="5"
                              PreviewMouseRightButtonDown="GridRports_PreviewMouseRightButtonDown">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="复制该条目" Click="RportCtxCopy_Click"/>
                                <MenuItem Header="停止该条目" Click="RportCtxStop_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="sid" Binding="{Binding Sid}" Width="86"/>
                            <DataGridTextColumn Header="绑定端口" Binding="{Binding PortText}" Width="118"/>
                            <DataGridTextColumn Header="回连目标" Binding="{Binding TargetText}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="6" Background="{StaticResource Bg}" CornerRadius="6"
                            BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,10,0,0"
                            Padding="10,8" Height="96">
                        <TextBox x:Name="ProxyMsg" Style="{StaticResource Area}" IsReadOnly="True"
                                 AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas"
                                 FontSize="11" VerticalScrollBarVisibility="Auto" IsTabStop="False"
                                 Text="就绪。启动 SOCKS 后这里显示服务端返回的 message 与 usage（含 curl --socks5-hostname 用法）。"/>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========== 14. 脚本 (Aggressor 插件: 菜单树 / 命令 / 诊断) ========== -->
            <TabItem Header="脚本" x:Name="TabScripts">
                <Grid x:Name="ScriptTabRoot" Margin="12,12,12,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="0.95*"/>
                        <RowDefinition Height="1.05*"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="0.85*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,8">
                        <TextBlock Text="脚本引擎" Style="{StaticResource Title}"/>
                        <TextBlock x:Name="ScriptStat" Text="尚未同步 (GET /api/scripts)" Style="{StaticResource Sub}"
                                   Margin="12,3,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="{StaticResource Panel2}" CornerRadius="6"
                            Padding="10,8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button Content="刷新" Style="{StaticResource Mini}"
                                        Click="ScriptRefresh_Click"
                                        ToolTip="重新拉取 GET /api/scripts（菜单树 / 命令 / 诊断 / 输出）"/>
                                <Button Content="执行选中命令" Style="{StaticResource Mini}" Margin="6,0,0,0"
                                        Click="ScriptRunCmd_Click"
                                        ToolTip="执行命令表里的命令，$1 = 当前会话号（POST /api/script/run）"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" x:Name="ScriptHint" Style="{StaticResource Hint}"
                                       Margin="12,0,0,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Text="菜单树来自 GET /api/scripts.menus；会话/进程/目标库右键会挂载对应 parent 的插件菜单。"/>
                        </Grid>
                    </Border>

                    <!-- 插件包: 从插件根里挑"要加载哪个包"(包 = 目录或单个 .cna)。
                         服务端按包重建脚本引擎, 所以本区域是"选择 + 应用", 不是增量勾选。
                         工具栏里的两段长文本强制单行(NoWrap + 省略号 + 统计列 MaxWidth):
                         否则在宽度不够时会逐字换行, 把上面这个 Auto 行撑到上千像素, 下面的
                         表格被挤成 0 高 —— 实测踩到过 (表高 0 时界面看起来就是"没有数据")。 -->
                    <Grid x:Name="PluginArea" Grid.Row="2" Margin="0,0,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="PluginBar" Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource Panel2}" CornerRadius="6"
                                Padding="10,8" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="插件包" Style="{StaticResource Label}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="PluginRootBox" Style="{StaticResource Field}" Width="320"
                                             FontFamily="Consolas" FontSize="11"
                                             ToolTip="插件根目录（服务端 --plugins-dir）。改完点『切换目录』：服务端先改根再重建引擎，选中集合会被清空，新目录下的包需要重新勾选。"/>
                                    <Button Content="切换目录" Style="{StaticResource Mini}" Margin="6,0,0,0"
                                            Click="PluginRootSet_Click"
                                            ToolTip="POST /api/plugin/set {paths:[], root:...} —— 改插件根并重建引擎（选中集合与手工添加的路径都清空）"/>
                                    <Button Content="浏览…" Style="{StaticResource Mini}" Margin="6,0,0,0"
                                            Click="PluginBrowse_Click"
                                            ToolTip="弹出文件资源管理器挑任意位置的 .cna（可多选，不限插件根目录）。选中的文件进入待加载集合，点『应用选择』与勾选的包一起 POST /api/plugin/set。绝对路径原样提交给服务端（服务端自行解析相对路径）。"/>
                                    <Button Content="刷新列表" Style="{StaticResource Mini}" Margin="6,0,0,0"
                                            Click="PluginRefresh_Click"
                                            ToolTip="重新拉取 GET /api/plugins。包列表不参与 2 秒轮询，只在首次进入本页 / 点这里 / 应用选择或切换目录成功之后拉取（见代码注释里的取舍）。"/>
                                    <Button Content="应用选择" Style="{StaticResource Primary}" Margin="6,0,0,0"
                                            Click="PluginApply_Click"
                                            ToolTip="POST /api/plugin/set {paths:[勾选的包 + 手工添加的路径]} —— 服务端重建脚本引擎，之后自动刷新菜单树 / 命令 / 诊断 / missing"/>
                                    <Button Content="全部卸载" Style="{StaticResource Ghost}" Margin="6,0,0,0"
                                            Click="PluginUnloadAll_Click"
                                            ToolTip="POST /api/plugin/set {paths:[]} —— 卸载全部插件包与手工添加的脚本，只留 scripts/*.cna 自研脚本"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="PluginHint" Style="{StaticResource Hint}" TextWrapping="NoWrap"
                                           Margin="12,0,0,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Text="勾选要加载的插件包（或点『浏览…』挑任意位置的 .cna）→ 『应用选择』。空选择应用 = 全部卸载；没有主文件(main 为空)的包不能勾选，原因见最右列。"/>
                                <TextBlock Grid.Column="2" x:Name="PluginStat" Style="{StaticResource Hint}" TextWrapping="NoWrap" MaxWidth="430"
                                           Margin="12,0,0,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Text="尚未拉取 GET /api/plugins"/>
                            </Grid>
                        </Border>

                        <!-- 手工添加的脚本 (服务端 external[]): 不在插件根下的路径。
                             必须能看见 + 能单独移除 —— 它们同样被持久化, 重启后引擎照常加载。
                             与包表格**并排**(右列 Auto, 空集合时 Collapsed 收成 0 宽), 不抢高度:
                             早先把它放在下面一条 Auto 行时, 面板一出现就把包表格挤得只剩表头
                             (实测: 插件区 191px, 工具栏 59 + 面板 103, 表格压到 MinHeight 80 后仍溢出被裁),
                             与 7.12 第 50 条是同一类事故。 -->
                        <DataGrid x:Name="GridPlugins" Grid.Row="1" Grid.Column="0" MinHeight="80">
                            <DataGrid.Resources>
                                <!-- 不可勾选的包(无主文件): 复选框置灰, 原因在 ToolTip 与最右列 -->
                                <Style TargetType="CheckBox" BasedOn="{StaticResource Chk}">
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.3"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="加载" Width="54">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Checked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding Selectable}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Click="PluginCheck_Click"
                                                      ToolTip="{Binding BlockWhy}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="名称" Width="210">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" Foreground="{Binding RowBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding TooltipText}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="类型" Binding="{Binding KindText}" Width="56"/>
                                <DataGridTextColumn Header="文件数" Binding="{Binding FilesText}" Width="62"/>
                                <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="80"/>
                                <DataGridTemplateColumn Header="当前选中" Width="78">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                                                       VerticalAlignment="Center"
                                                       ToolTip="服务端 loaded 字段：该包是否在当前选中集合里（≠ 加载成功）"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="菜单项" Width="68">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding MenusText}" Foreground="{Binding MenusBrush}"
                                                       VerticalAlignment="Center"
                                                       ToolTip="该包当前贡献的菜单项数（加载出来什么的直接证据）。未选中时服务端恒回 0；已选中但该包没注册菜单项也是 0。"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="主文件 / 错误信息" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DetailText}" Foreground="{Binding RowBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding TooltipText}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border x:Name="ExtArea" Grid.Row="1" Grid.Column="1" Width="336" Margin="6,0,0,0"
                                Background="{StaticResource Panel2}" CornerRadius="6"
                                Padding="10,8" Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <TextBlock Text="手工添加的脚本" Style="{StaticResource Label}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ExtStat" Style="{StaticResource Sub}"
                                               Margin="8,3,0,0" VerticalAlignment="Center"
                                               Text="手工添加 0 个"/>
                                </StackPanel>

                                <TextBlock Grid.Row="1" x:Name="ExtHint" Style="{StaticResource Hint}"
                                           Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                           Text="点『浏览…(选 .cna 文件)』挑任意位置 .cna（可多选），与勾选的包合并提交。"/>

                                <ScrollViewer Grid.Row="2" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ListPluginExternal">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}"
                                                               Foreground="{Binding RowBrush}" FontWeight="Bold"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding TooltipText}"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ExistsText}"
                                                               Foreground="{Binding ExistsBrush}" Margin="8,0,0,0"
                                                               VerticalAlignment="Center" ToolTip="{Binding TooltipText}"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding MenusText}"
                                                               Foreground="{Binding MenusBrush}" Margin="8,0,0,0"
                                                               VerticalAlignment="Center"
                                                               ToolTip="该脚本当前贡献的菜单项数（服务端实测；未加载或没注册菜单项时为 0）"/>
                                                    <Button Grid.Row="0" Grid.Column="3" Content="移除" Style="{StaticResource Mini}"
                                                            Margin="8,0,0,0" Click="PluginExtraRemove_Click"
                                                            ToolTip="把这条从待提交集合里去掉；点『应用选择』后服务端重建引擎，它即被卸载（磁盘上的文件不动）。"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                                                               Text="{Binding DetailText}" Foreground="{Binding RowBrush}"
                                                               TextWrapping="Wrap" FontSize="10" Margin="0,1,0,0"
                                                               ToolTip="{Binding TooltipText}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.85*"/>
                            <ColumnDefinition Width="0.95*"/>
                            <ColumnDefinition Width="1.6*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="0,0,6,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" x:Name="ScriptFileTitle" Text="已加载脚本 0"
                                       Style="{StaticResource Label}" Margin="0,0,0,5"/>
                            <DataGrid x:Name="GridScriptFiles" Grid.Row="1">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="脚本文件" Binding="{Binding Name}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <Grid Grid.Column="1" Margin="6,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" x:Name="ScriptCmdTitle" Text="注册命令 0"
                                       Style="{StaticResource Label}" Margin="0,0,0,5"/>
                            <DataGrid x:Name="GridScriptCmds" Grid.Row="1"
                                      MouseDoubleClick="GridScriptCmds_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="命令" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="同名菜单项" Binding="{Binding Hit}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <Grid Grid.Column="2" Margin="6,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" x:Name="ScriptMenuTitle" Text="插件菜单树 0"
                                       Style="{StaticResource Label}" Margin="0,0,0,5"/>
                            <TreeView x:Name="TreeScriptMenus" Grid.Row="1"
                                      Background="{StaticResource Panel2}"
                                      BorderBrush="{StaticResource Line}"
                                      Foreground="{StaticResource Fg}"
                                      MouseDoubleClick="TreeScriptMenus_MouseDoubleClick">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <TextBlock Text="{Binding Text}" Padding="0,1">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSep}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Inert}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Grid>
                    </Grid>

                    <GridSplitter Grid.Row="4" Height="6" Background="Transparent"/>

                    <Grid Grid.Row="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="0,0,6,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" x:Name="ScriptMissingTitle" Text="missing 未实现的 UI 函数 0"
                                       Style="{StaticResource Label}" Margin="0,0,0,5"/>
                            <ListBox x:Name="ListScriptMissing" Grid.Row="1"
                                     Background="{StaticResource Bg}" Foreground="{StaticResource Warn}"
                                     BorderBrush="{StaticResource Line}" FontFamily="Consolas"
                                     FontSize="11" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <!-- 绑定的是 ScriptTextRow, 必须有 DisplayMemberPath/ItemTemplate,
                                     否则 WPF 直接调 ToString() 显示成类型名 -->
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}" Foreground="{StaticResource Warn}"
                                                   FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <Grid Grid.Column="1" Margin="6,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" x:Name="ScriptDiagTitle" Text="diag 加载诊断 0"
                                       Style="{StaticResource Label}" Margin="0,0,0,5"/>
                            <ListBox x:Name="ListScriptDiag" Grid.Row="1"
                                     Background="{StaticResource Bg}" Foreground="{StaticResource Fg}"
                                     BorderBrush="{StaticResource Line}" FontFamily="Consolas"
                                     FontSize="11" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}" Foreground="{StaticResource Fg}"
                                                   FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <Grid Grid.Column="2" Margin="6,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" x:Name="ScriptOutTitle" Text="脚本输出 0 行"
                                       Style="{StaticResource Label}" Margin="0,0,0,5"/>
                            <ListBox x:Name="ListScriptOut" Grid.Row="1"
                                     Background="{StaticResource Bg}" Foreground="{StaticResource Fg}"
                                     BorderBrush="{StaticResource Line}" FontFamily="Consolas"
                                     FontSize="11" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}" Foreground="{StaticResource Fg}"
                                                   FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>

                    <TextBlock Grid.Row="6" Style="{StaticResource Hint}" Margin="2,8,0,0"
                               Text="双击命令列表可执行（$1 = 当前会话号）；双击菜单树的可执行项同样下发 POST /api/script/run。missing 列出插件调用过但本引擎未实现的 CS 客户端 UI 函数：这些菜单项点击后不会有 CS 客户端那样的界面效果。"/>
                </Grid>
            </TabItem>

            <!-- ========== 15. 作业 (统一 Job 体系, 对标 CS 的 jobs / jobkill) ========== -->
            <TabItem Header="作业" x:Name="TabJobs">
                <Grid Margin="12,12,12,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,8">
                        <TextBlock Text="后台作业" Style="{StaticResource Title}"/>
                        <TextBlock x:Name="JobStat" Text="尚未同步 (GET /api/state.jobs)"
                                   Style="{StaticResource Sub}" Margin="12,3,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="{StaticResource Panel2}" CornerRadius="6"
                            Padding="10,8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="会话" Foreground="{StaticResource Dim}"
                                       FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="JobSidBox" Grid.Column="1" Style="{StaticResource Combo}"
                                      ToolTip="过滤作业列表：全部会话 / 跟随当前附着会话 / 指定会话（纯客户端过滤，不额外请求服务端）"
                                      SelectionChanged="JobSidBox_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}" FontSize="12"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <CheckBox x:Name="JobRunningBox" Grid.Column="2" Content="只看 running"
                                      Style="{StaticResource Chk}" Margin="14,0,0,0"
                                      ToolTip="只显示 status = running 的作业（服务端 running / done / killed / failed）"
                                      Checked="JobRunningBox_Changed" Unchecked="JobRunningBox_Changed"/>
                            <TextBlock x:Name="JobCount" Grid.Column="3" Text="0 个" Style="{StaticResource Sub}"
                                       Margin="14,3,0,0"/>
                            <Button Grid.Column="5" Content="终止选中作业" Style="{StaticResource Mini}"
                                    ToolTip="对选中作业下发 POST /api/command {sid, &quot;jobkill &lt;id&gt;&quot;}，服务端回什么就在下方输出区原样显示什么（含『无法中途终止』那句）"
                                    Click="JobKill_Click"/>
                            <Button Grid.Column="6" Content="刷新" Style="{StaticResource Mini}"
                                    Click="JobRefresh_Click"/>
                        </Grid>
                    </Border>

                    <DataGrid x:Name="GridJobs" Grid.Row="2"
                              PreviewMouseRightButtonDown="GridJobs_PreviewMouseRightButtonDown">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="终止该作业 (jobkill)" Click="JobCtxKill_Click"/>
                                <MenuItem Header="复制作业信息" Click="JobCtxCopyInfo_Click"/>
                                <Separator/>
                                <MenuItem Header="只看该会话" Click="JobCtxOnlySid_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="作业号" Binding="{Binding Id}" Width="72"/>
                            <DataGridTextColumn Header="会话" Binding="{Binding Sid}" Width="86"/>
                            <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="108"/>
                            <DataGridTextColumn Header="详情" Binding="{Binding DetailText}" Width="*"/>
                            <DataGridTemplateColumn Header="状态" Width="134">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                    ToolTip="{Binding TimeTip}">
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                     Fill="{Binding StatusBrush}"/>
                                            <TextBlock Text="{Binding StatusText}" Margin="7,0,0,0"
                                                       Foreground="{Binding StatusBrush}" FontSize="11.5"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="可终止" Width="86">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding KillText}" VerticalAlignment="Center"
                                                   FontSize="11.5" ToolTip="{Binding KillHint}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Ok}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Killable}" Value="False">
                                                            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="耗时" Binding="{Binding ElapsedText}" Width="96"/>
                            <DataGridTextColumn Header="备注" Binding="{Binding NoteText}" Width="190"/>
                            <DataGridTemplateColumn Header="操作" Width="72">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="终止" Style="{StaticResource Mini}"
                                                IsEnabled="{Binding Killable}"
                                                ToolTip="{Binding KillHint}"
                                                ToolTipService.ShowOnDisabled="True"
                                                Click="JobRowKill_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="3" x:Name="JobOutTitle" Text="jobkill 输出 0 行"
                               Style="{StaticResource Label}" Margin="2,10,0,6"/>

                    <Border Grid.Row="4" Background="{StaticResource Bg}" CornerRadius="6"
                            BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="10,8"
                            Height="118">
                        <TextBox x:Name="JobMsg" Style="{StaticResource Area}" IsReadOnly="True"
                                 AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas"
                                 FontSize="11" VerticalScrollBarVisibility="Auto" IsTabStop="False"
                                 Text="就绪。这里原样显示 jobkill 的服务端回话（ok / text / error），包括不可终止作业的『无法中途终止』说明。"/>
                    </Border>

                    <TextBlock Grid.Row="5" x:Name="JobHint" Style="{StaticResource Hint}" Margin="2,8,0,0"
                               Text="来源: GET /api/state 的 jobs / jobs_running（等价 GET /api/jobs）。耗时由 started/ended 计算，ended=0 表示仍在运行。killable=false 的作业是一次性下发，服务端 jobkill 会如实回『无法中途终止』——按钮灰显，鼠标悬停可看原因，工具栏按钮仍可下发并原样看到服务端回话。"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ==================== 状态栏 ==================== -->
        <Border Grid.Row="2" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusBar" Grid.Column="0" Text="就绪"
                           Foreground="{StaticResource Dim}" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="StatusRight" Grid.Column="1" Text=""
                           Foreground="{StaticResource Dim}" FontSize="11"
                           VerticalAlignment="Center" FontFamily="Consolas"/>
            </Grid>
        </Border>
    </Grid>
</Window>
