        item "载荷能力说明" {
            show_message(csdev_head("Linux 载荷") . "\n\n" .
                " beacon 主机载荷\n" .
                "  shell / exec / ls / cd / pwd\n" .
                "  download / upload / ps / kill\n" .
                "  sleep (自适应心跳 + 指数退避)\n\n" .
                " stager 无文件加载器\n" .
                "  memfd_create + fexecve (无文件落地)\n" .
                "  /dev/shm 回退路径\n" .
                "  Process name mask [kworker/0:2]\n\n" .
                csdev_rule() . "\n" .
                " Anti-debug / string obfusc / RC4 session / no system() calls");
        }
    }
}

popup help {
    menu "&cs_dev" {
        item "HTML 面板 (浏览器)" { csdev_open_html(); }
        separator();
        item "关于 cs_dev"      { csdev_about(); }
        item "查看模块状态"     { csdev_status(); }
        separator();
        item "编译并部署全部 kits" {
            println("\c9[cs_dev]\c7 编译并部署 ...");
            exec(csdev_ps(csdev_tool("deploy.ps1")));
            show_message("编译部署已启动, 详见控制台输出\n\n重启客户端生效");
        }
        item "重建变体库" {
            println("\c9[cs_dev]\c7 重建变体库 ...");
            exec(csdev_ps(csdev_tool("build_library.ps1")));
            show_message("变体库重建已启动, 详见控制台输出");
        }
        item "回滚客户端 jar" {
            exec(csdev_ps(csdev_tool("apply_profile.ps1")) . " -Restore");
            show_message("回滚已发起, 重启客户端恢复原始 jar");
        }
    }
}

