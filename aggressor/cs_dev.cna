        item "自研打包 (shellcode -> EXE)" { csdev_pack_dialog(); }
        item "Payload 生成器 (全格式)" { csdev_gen_dialog(); }
        item "自研 Stager 生成 (无CS模板)" { csdev_stager_dialog(); }
        item "生成 Windows Payload (全部)"     { openWindowsExecutableStageAllDialog(); }

        separator();
